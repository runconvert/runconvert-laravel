{
    "name": "runconvert/runconvert-laravel",
    "description": "Official RunConvert SDK for Laravel: convert files between 240+ formats",
    "type": "library",
    "license": "MIT",
    "keywords": ["runconvert", "laravel", "file converter", "convert", "pdf", "api", "sdk"],
    "homepage": "https://www.runconvert.com/docs",
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "runconvert/runconvert-php": "^0.1"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": { "RunConvert\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "RunConvert\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["RunConvert\\Laravel\\RunConvertServiceProvider"],
            "aliases": { "RunConvert": "RunConvert\\Laravel\\Facades\\RunConvert" }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
